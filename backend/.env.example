# ==========================================
# STELIX (MYHEALTHCHAIN) BACKEND ENVIRONMENT VARIABLES
# ==========================================

# 1. Supabase Database & Auth Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_KEY=your_supabase_anon_key

# 2. Google Gemini Generative AI Configuration
GEMINI_API_KEY=your_google_gemini_api_key

# 3. Stripe Payment Gateway Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# 4. ElevenLabs & Voice AI Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id
NGROK_DOMAIN=your-custom-ngrok-domain.ngrok-free.dev

# 5. WhatsApp & Gateway Integration
WHATSAPP_GATEWAY_URL=http://localhost:3001
BACKEND_URL=http://localhost:8000

# 6. Langfuse AI Observability & Tracing
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# 7. Pinata IPFS Decentralized Storage
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_API_KEY=your_pinata_secret_api_key
PINATA_JWT=your_pinata_jwt_token

# 8. Server Security & CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ENVIRONMENT=development
PORT=8000
